@model LawPortal.Core.Entities.Documents.DocDocument
@inject IStringLocalizer<SharedResource> Localizer
@{
    var addMode = (bool)ViewBag.IsAddMode;
    var folderId = (int)ViewBag.FolderId;
    var userFileName = (string)ViewBag.UserFileName;
    var dialogId = "releaseDocDetailDialog";
    var formId = "releaseDocDetailForm";
}

<div id="@dialogId" style="display:none;">
    <form id="@formId" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DocId" value="@Model.DocId" />
        <input type="hidden" name="FolderId" value="@folderId" />
        <div class="cpiMainEntry px-3 pt-3">
            @* Document Name — full width at top *@
            <div class="form-row">
                <div class="col">
                    <div class="form-group float-label">
                        <label for="DocName">@Localizer["Document Name"]</label>
                        <input type="text" class="form-control form-control-sm" name="DocName" value="@Model.DocName" required />
                    </div>
                </div>
            </div>

            @* The dialog carries only Name, Author and Remarks. Document type is
               not asked for — it is left unset on a new document and untouched on
               an existing one. A new document takes its file here; an existing
               one cannot have it swapped, because the document grids are filtered
               by file type and a replacement of a different type would move the
               document out from under the panel it lives in. *@
            <div class="form-row">
                <div class="col">
                    <div class="form-group float-label">
                        <label for="Author">@Localizer["Author"]</label>
                        <input type="text" class="form-control form-control-sm" name="Author" value="@Model.Author" readonly />
                    </div>
                </div>
            </div>

            @if (addMode)
            {
                @* File for the new document: browse or drop. Plain markup rather
                   than Html.Kendo().Upload() because Kendo only wires up dropping
                   in async mode (_supportsDrop requires an async saveUrl), and
                   this dialog posts the file with the rest of the form. The
                   dropped file is assigned to the file input below, so it still
                   arrives as UploadedFile. *@
                <div class="form-row pt-1 pb-2">
                    <div class="col-12">
                        <div id="@(formId)_drop" class="doc-file-drop">
                            <input type="file" name="UploadedFile" id="@(formId)_file" class="d-none" />
                            <span class="fal fa-cloud-upload-alt mr-2"></span>
                            <a href="#" onclick="return false;" class="doc-file-browse">@Localizer["Select a file"]</a>
                            <span class="text-muted">@Localizer["or drop it here"]</span>
                            <div class="doc-file-chosen small mt-1"></div>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(userFileName))
            {
                @* The attached file, for reference only. *@
                <div class="form-row pt-1 pb-1" style="font-size:small">
                    <div class="col-12">
                        <span class="fal fa-file mr-1"></span> @userFileName
                    </div>
                </div>
            }

            @* Remarks *@
            <div class="form-row">
                <div class="col">
                    <div class="form-group float-label">
                        <label for="Remarks">@Localizer["Remarks"]</label>
                        <textarea class="form-control form-control-sm" rows="4" name="Remarks" style="padding-top:20px;">@Model.Remarks</textarea>
                    </div>
                </div>
            </div>
        </div>

        @* Save / Close buttons *@
        <div class="form-row px-3 pb-2 pt-1">
            <div class="col d-flex justify-content-end">
                <button type="submit" class="btn btn-primary btn-sm mr-2"><i class="fal fa-check mr-1"></i>@Localizer["Save"]</button>
                <button type="button" class="btn btn-light btn-sm border" onclick="$('#@dialogId').data('kendoWindow').close()"><i class="fal fa-undo mr-1"></i>@Localizer["Close"]</button>
            </div>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        var dialog = $("#@dialogId");
        dialog.kendoWindow({
            width: "850px",
            title: "@Localizer["Document Detail"]",
            visible: false,
            modal: true,
            actions: ["Close"],
            close: function () { this.destroy(); dialog.remove(); }
        });
        dialog.data("kendoWindow").center().open();

        var form = $("#@formId");

        // File picker / drop area (add mode only). Assigning a DataTransfer's
        // FileList to the input is what lets a dropped file post with the form.
        var drop = $("#@(formId)_drop");
        if (drop.length) {
            var fileInput = document.getElementById("@(formId)_file");
            var showChosen = function () {
                var f = fileInput.files && fileInput.files[0];
                drop.find(".doc-file-chosen").html(
                    f ? '<span class="fal fa-file mr-1"></span>' + kendo.htmlEncode(f.name) : "");
            };
            drop.on("click", ".doc-file-browse", function () { fileInput.click(); });
            $(fileInput).on("change", showChosen);
            drop.on("dragenter dragover", function (e) {
                e.preventDefault(); e.stopPropagation();
                drop.addClass("doc-file-drop-over");
            });
            drop.on("dragleave dragend", function () { drop.removeClass("doc-file-drop-over"); });
            drop.on("drop", function (e) {
                e.preventDefault(); e.stopPropagation();
                drop.removeClass("doc-file-drop-over");
                var dropped = e.originalEvent.dataTransfer && e.originalEvent.dataTransfer.files;
                if (!dropped || !dropped.length) return;
                // Keep the first file only — a document holds one file.
                var dt = new DataTransfer();
                dt.items.add(dropped[0]);
                fileInput.files = dt.files;
                showChosen();
            });
        }
        form.on("submit", function (e) {
            e.preventDefault();
            var formData = new FormData(form[0]);
            if (typeof cpiLoadingSpinner !== 'undefined') cpiLoadingSpinner.show();
            $.ajax({
                type: "POST",
                url: "@Url.Action("SaveDocumentDetail", "Release", new { area = "Releases" })",
                data: formData,
                contentType: false,
                processData: false,
                success: function (result) {
                    if (typeof cpiLoadingSpinner !== 'undefined') cpiLoadingSpinner.hide();
                    dialog.data("kendoWindow").close();
                    if (typeof pageHelper !== 'undefined') pageHelper.showSuccess("@Localizer["Document saved successfully."]");
                    $(document).trigger("releaseDocSaved");
                },
                error: function (xhr) {
                    if (typeof cpiLoadingSpinner !== 'undefined') cpiLoadingSpinner.hide();
                    if (typeof pageHelper !== 'undefined') pageHelper.showErrors(xhr);
                    else alert("Error saving document.");
                }
            });
        });
    });
</script>
