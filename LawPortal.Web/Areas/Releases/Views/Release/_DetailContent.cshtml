@model Release
@inject IStringLocalizer<SharedResource> Localizer
@{
    var id = Model.ReleaseId;
    var addMode = id == 0;

    var detailPagePermission = (DetailPagePermission)ViewData["PagePermission"];
    var fullModify = detailPagePermission.CanEditRecord && (!detailPagePermission.CanEditRemarksOnly);
    bool isReadOnly = !fullModify || Model.IsLocked;

    var systemsList = (List<string>)ViewData["SystemsList"] ?? new List<string>();
    var systemItems = systemsList.Select(s => new SelectListItem { Text = s, Value = s }).ToList();
}
<form id="detailForm" method="post" cpi-detail-form
      action="@Url.Action("Save", "Release", new { area = "Releases" })"
      data-error-message="@Localizer["An error occurred. No updates were made."]"
      data-save-message="@Localizer["Record has been saved successfully."]"
      data-cancel-title="@Localizer["Confirm Cancel Changes"]"
      data-cancel-message="@Localizer["Changes will not be saved. Do you want to continue?"]"
      data-delete-title="@Localizer["Confirm Delete"]"
      data-delete-message="@Localizer["You are about to delete this record. This operation cannot be undone."]"
      data-delete-success="@Localizer["Record has been deleted successfully."]">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReleaseId" />
    @await Component.InvokeAsync("DetailPageNavLinks", new { pagePermission = detailPagePermission, title = "", addMode = addMode })

    <div class="page-content detail cpiMainEntry">
        <div class="form-row">
            <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4">
                <div class="form-group float-label">
                    <label asp-for="Name"></label>
                    <input type="text" class="form-control form-control-sm" asp-for="Name" asp-is-readonly="@isReadOnly" asp-is-autofocus="@addMode" />
                    <span asp-validation-for="Name"></span>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 col-xl-2">
                <div class="form-group float-label">
                    <label asp-for="Year"></label>
                    @if (isReadOnly)
                    {
                        <input type="number" class="form-control form-control-sm" asp-for="Year" readonly />
                    }
                    else
                    {
                        @(Html.Kendo().NumericTextBox<int>()
                            .Name("Year")
                            .Value(DateTime.Now.Year)
                            .Format("####")
                            .Decimals(0)
                            .Min(2000)
                            .Max(2100)
                            .HtmlAttributes(new { style = "width: 100%", placeholder = " " })
                        )
                    }
                    <span asp-validation-for="Year"></span>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 col-xl-2">
                <div class="form-group float-label">
                    <label asp-for="Quarter"></label>
                    @if (isReadOnly)
                    {
                        <input type="text" class="form-control form-control-sm" asp-for="Quarter" readonly />
                    }
                    else
                    {
                        @(Html.Kendo().DropDownList()
                            .Name("Quarter")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Q1", Value = "Q1" },
                                new SelectListItem { Text = "Q2", Value = "Q2" },
                                new SelectListItem { Text = "Q3", Value = "Q3" },
                                new SelectListItem { Text = "Q4", Value = "Q4" }
                            })
                            .Value(Model.Quarter ?? "Q1")
                            .HtmlAttributes(new { style = "width: 100%" })
                        )
                    }
                    <span asp-validation-for="Quarter"></span>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-3 col-xl-2">
                <div class="form-group float-label">
                    <label for="SystemType">@Localizer["System"]</label>
                    @if (isReadOnly)
                    {
                        <input type="text" class="form-control form-control-sm" asp-for="SystemType" readonly />
                    }
                    else
                    {
                        @(Html.Kendo().DropDownList()
                            .Name("SystemType")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(systemItems)
                            .Value(Model.SystemType ?? systemItems.FirstOrDefault()?.Value)
                            .HtmlAttributes(new { style = "width: 100%" })
                        )
                    }
                    <span asp-validation-for="SystemType"></span>
                </div>
            </div>
        </div>
        @{
            var sysTypeForNotes = Model.SystemType ?? "";
            // Show Patent notes unless this release is trademark-only; show Trademark
            // notes unless it's patent-only. Matches the Generate MDB button logic.
            var showPatentNotes = !sysTypeForNotes.StartsWith("Tmk", StringComparison.OrdinalIgnoreCase);
            var showTmkNotes = !sysTypeForNotes.StartsWith("Pat", StringComparison.OrdinalIgnoreCase);
        }
        <div class="form-row">
            @if (showPatentNotes)
            {
                <div class="col-md-6">
                    <div class="form-group float-label">
                        <label asp-for="ReportNotesPatent"></label>
                        <textarea class="form-control form-control-sm" rows="3"
                                  asp-for="ReportNotesPatent" asp-is-readonly="@isReadOnly"
                                  placeholder="@Localizer["Rendered at the top of the Patent report PDF"]"></textarea>
                        <span asp-validation-for="ReportNotesPatent"></span>
                    </div>
                </div>
            }
            else
            {
                @* Preserve existing value on post when the field is hidden. *@
                <input type="hidden" asp-for="ReportNotesPatent" />
            }
            @if (showTmkNotes)
            {
                <div class="col-md-6">
                    <div class="form-group float-label">
                        <label asp-for="ReportNotesTrademark"></label>
                        <textarea class="form-control form-control-sm" rows="3"
                                  asp-for="ReportNotesTrademark" asp-is-readonly="@isReadOnly"
                                  placeholder="@Localizer["Rendered at the top of the Trademark report PDF"]"></textarea>
                        <span asp-validation-for="ReportNotesTrademark"></span>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="ReportNotesTrademark" />
            }
        </div>
        @if (!addMode)
        {
            var sysType = Model.SystemType ?? "";
            var showPatentBtn = !sysType.StartsWith("Tmk", StringComparison.OrdinalIgnoreCase);
            var showTmkBtn = !sysType.StartsWith("Pat", StringComparison.OrdinalIgnoreCase);
            <div class="form-row align-items-center">
                <div class="col-auto">
                    @if (!Model.IsLocked)
                    {
                        @if (showPatentBtn)
                        {
                            <button type="button" class="btn btn-primary btn-sm mr-2 btnGenerateMdb"
                                    data-area="Patent"
                                    data-url="@Url.Action("GenerateMdb", new { id = Model.ReleaseId, mdbArea = "Patent" })">
                                <i class="fal fa-database pr-1"></i> @Localizer["Generate Patent MDB"]
                            </button>
                        }
                        @if (showTmkBtn)
                        {
                            <button type="button" class="btn btn-primary btn-sm btnGenerateMdb"
                                    data-area="Trademark"
                                    data-url="@Url.Action("GenerateMdb", new { id = Model.ReleaseId, mdbArea = "Trademark" })">
                                <i class="fal fa-database pr-1"></i> @Localizer["Generate Trademark MDB"]
                            </button>
                        }
                    }
                </div>
                @if (Model.IsLocked)
                {
                    <div class="col-auto">
                        <span class="badge badge-secondary px-3 py-2">
                            <i class="fal fa-lock pr-1"></i>
                            @Localizer["Locked"] @(Model.LockedAt?.ToString("yyyy-MM-dd") ?? "")
                            @(Model.LockedBy != null ? $"by {Model.LockedBy}" : "")
                        </span>
                    </div>
                }
            </div>
        }
    </div>

    @if (!addMode)
    {
        <ul class="nav nav-tabs detail cpiDetailInfoNav nav-tabs-horizontal" role="tablist">
            <li class="nav-item">
                <a id="releaseDetailDocumentsTab" href="#releaseDetailDocumentsTabContent" class="nav-link active" data-toggle="tab" role="tab" aria-controls="releaseDetailDocumentsTabContent" title="@Localizer["Documents"]">@Localizer["Documents"]</a>
            </li>
            <li class="nav-item">
                <a id="releaseDetailReportsTab" href="#releaseDetailReportsTabContent" class="nav-link" data-toggle="tab" role="tab" aria-controls="releaseDetailReportsTabContent" title="@Localizer["Reports"]">@Localizer["Reports"]</a>
            </li>
            <li class="nav-item">
                <a id="releaseDetailSnapshotTab" href="#releaseDetailSnapshotTabContent" class="nav-link" data-toggle="tab" role="tab" aria-controls="releaseDetailSnapshotTabContent" title="@Localizer["Quarter Snapshot"]">@Localizer["Quarter Snapshot"]</a>
            </li>
        </ul>
        <div class="tab-content detail">
            <div class="tab-pane active show p-0" id="releaseDetailDocumentsTabContent" role="tabpanel" aria-labelledby="releaseDetailDocumentsTab">
                @await Html.PartialAsync("_DocumentTree", Model,
                    new ViewDataDictionary(ViewData)
                    {
                        ["extFilter"]          = ".pdf",
                        ["panelLabel"]          = "Reports",
                        ["companionExtFilter"]  = ".mdb",
                        ["companionPanelLabel"] = "MDB Files"
                    })
            </div>
            <div class="tab-pane" id="releaseDetailReportsTabContent" role="tabpanel" aria-labelledby="releaseDetailReportsTab">
                <div class="p-3">
                    <div id="reportMdbList_@id"><p class="text-muted">Loading...</p></div>
                    <div id="reportStatus_@id" class="mt-2" style="display:none;"></div>
                </div>
                <script>
                    $(document).ready(function () {
                        var releaseId = @id;
                        var mdbListDiv = $('#reportMdbList_' + releaseId);
                        var statusDiv = $('#reportStatus_' + releaseId);

                        // Load MDB files, group by Pat/Tmk, one section per type
                        function loadMdbFiles() {
                            $.get('@Url.Action("GetMdbFiles")', { releaseId: releaseId }, function (data) {
                                if (!data || data.length === 0) {
                                    mdbListDiv.html('<p class="text-muted">No MDB files found. Generate MDB files first.</p>');
                                    return;
                                }
                                // Group by Pat/Tmk — pick the latest (last) MDB per type as the current
                                var patDocs = [], tmkDocs = [];
                                $.each(data, function (i, doc) {
                                    if (doc.DocName.toLowerCase().indexOf('pat') >= 0) patDocs.push(doc);
                                    else tmkDocs.push(doc);
                                });

                                function renderSection(label, isPat, docs) {
                                    if (!docs.length) return '';
                                    var section = '<div class="mb-4 report-section" data-is-pat="' + isPat + '">';
                                    section += '<h6 class="font-weight-bold mb-2">' + label + '</h6>';
                                    section += '<div class="form-row align-items-end">';
                                    section += '<div class="col-md-4"><label class="small text-muted">Current MDB:</label>';
                                    section += '<select class="form-control form-control-sm currentMdbSelect">';
                                    // Newest first — most recent generation is likely the one the author wants.
                                    for (var i = docs.length - 1; i >= 0; i--) {
                                        var d = docs[i];
                                        var selected = i === docs.length - 1 ? ' selected' : '';
                                        section += '<option value="' + d.DocId + '"' + selected + '>' + d.DocName + '</option>';
                                    }
                                    section += '</select></div>';
                                    section += '<div class="col-md-5"><label class="small text-muted">Compare Against:</label>';
                                    section += '<select class="form-control form-control-sm compareMdbSelect"></select></div>';
                                    if (!releaseIsLocked) {
                                        section += '<div class="col-auto"><button type="button" class="btn btn-sm btn-primary btnGenReport">';
                                        section += '<i class="fal fa-file-pdf pr-1"></i> Generate Report</button></div>';
                                    }
                                    section += '</div></div>';
                                    return section;
                                }

                                var html = renderSection('Patent', 'true', patDocs)
                                         + renderSection('Trademark', 'false', tmkDocs);
                                mdbListDiv.html(html);

                                // Populate each compare dropdown with MDB files from other releases
                                mdbListDiv.find('.report-section').each(function () {
                                    var section = $(this);
                                    var isPat = section.data('is-pat');
                                    var sel = section.find('.compareMdbSelect');
                                    $.get('@Url.Action("GetCompareMdbFiles")', { releaseId: releaseId, isPat: isPat }, function (mdbFiles) {
                                        sel.empty().append('<option value="">-- Select an MDB --</option>');
                                        $.each(mdbFiles, function (j, f) {
                                            sel.append('<option value="' + f.DocId + '" data-release-id="' + f.ReleaseId + '">' + f.Text + '</option>');
                                        });
                                    });
                                });
                            });
                        }
                        loadMdbFiles();

                        // Generate report
                        mdbListDiv.on('click', '.btnGenReport', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            var section = $(this).closest('.report-section');
                            var docId = section.find('.currentMdbSelect').val();
                            var compareSel = section.find('.compareMdbSelect');
                            var compareDocId = compareSel.val();
                            var compareReleaseId = compareSel.find('option:selected').data('release-id') || 0;
                            if (!docId) {
                                pageHelper.showErrors('Please select the current MDB to generate the report from.');
                                return;
                            }
                            if (!compareDocId) {
                                pageHelper.showErrors('Please select an MDB file to compare against.');
                                return;
                            }
                            var btn = $(this);
                            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Generating...');
                            statusDiv.hide();

                            $.post('@Url.Action("GenerateReport")', {
                                releaseId: releaseId,
                                compareDocId: compareDocId,
                                compareReleaseId: compareReleaseId,
                                docId: docId,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            }).done(function (result) {
                                btn.prop('disabled', false).html('<i class="fal fa-file-pdf pr-1"></i> Generate Report');
                                statusDiv.html('<div class="alert alert-success">' + (result.success || 'Report generated.') + '</div>').show();
                                // Switch to Documents tab and refresh
                                var docsTab = $('#releaseDetailDocumentsTab');
                                if (docsTab.length) docsTab.tab('show');
                                var treeEl = $('#documentTree_' + releaseId);
                                if (treeEl.length) {
                                    var tv = treeEl.data('kendoTreeView');
                                    if (tv) { tv.select($()); tv.dataSource.read(); }
                                    setTimeout(function() { releaseDocTree_@(id).fallbackFolderClick(); }, 500);
                                }
                            }).fail(function (e) {
                                btn.prop('disabled', false).html('<i class="fal fa-file-pdf pr-1"></i> Generate Report');
                                var msg = 'Error generating report.';
                                try { msg = JSON.parse(e.responseText); } catch (ex) { msg = e.responseText || msg; }
                                statusDiv.html('<div class="alert alert-danger">' + msg + '</div>').show();
                            });
                        });
                    });
                </script>
            </div>
            <div class="tab-pane p-0" id="releaseDetailSnapshotTabContent" role="tabpanel" aria-labelledby="releaseDetailSnapshotTab">
                <div class="d-flex" style="min-height:300px;">
                    <div id="snapshotList_@id" style="width:260px;min-width:220px;border-right:1px solid #dee2e6;overflow-y:auto;padding:0.75rem 0;">
                        <p class="text-muted small px-3">Loading...</p>
                    </div>
                    <div id="snapshotPanel_@id" style="flex:1;overflow:auto;padding:1rem;">
                        <p class="text-muted small">Select a table on the left to view its data.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-stamp">
            @await Component.InvokeAsync("RecordStamps", new { createdBy = Model.CreatedBy, dateCreated = Model.DateCreated, updatedBy = Model.UpdatedBy, lastUpdate = Model.LastUpdate, tStamp = new byte[0] })
        </div>
    }
</form>

<script>
    var releaseIsLocked = @(Model.IsLocked ? "true" : "false");

    $(document).ready(function() {

        // ── Quarter Snapshot tab ──────────────────────────────────────────
        var snapshotSummaryUrl = '@Html.Raw(Url.Action("SnapshotSummary", "Release", new { area = "Releases" }))';
        var snapshotDataUrl    = '@Html.Raw(Url.Action("SnapshotTableData", "Release", new { area = "Releases" }))';
        var releaseIdSnap      = @id;
        var $listDiv           = $('#snapshotList_' + releaseIdSnap);
        var $panelDiv          = $('#snapshotPanel_' + releaseIdSnap);
        var snapshotLoaded     = false;

        // ── Snapshot table renderer with per-column filter + sort ────────
        var snapState = { rows: [], columns: [], sortCol: null, sortDir: 1, filters: {} };

        function escHtml(v) {
            if (v === null || v === undefined) return '';
            return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        // Supports plain text (contains), prefix A* (starts-with), suffix *A
        // (ends-with), *phrase* (contains), and exact "phrase" (quoted exact).
        function matchFilter(cellVal, filterVal) {
            var cell = String(cellVal === null || cellVal === undefined ? '' : cellVal).toLowerCase();
            var f    = filterVal.trim().toLowerCase();
            if (!f) return true;
            if (f.charAt(0) === '"' && f.charAt(f.length - 1) === '"') {
                return cell === f.slice(1, -1);
            }
            if (f.indexOf('*') === -1) return cell.indexOf(f) !== -1;
            var startsWild = f.charAt(0) === '*';
            var endsWild   = f.charAt(f.length - 1) === '*';
            var inner      = f.replace(/^\*|\*$/g, '');
            if (startsWild && endsWild) return cell.indexOf(inner) !== -1;
            if (startsWild)            return cell.endsWith(inner);
            if (endsWild)              return cell.startsWith(inner);
            // pattern like a*b — split on * and check each segment in order
            var parts = f.split('*');
            var pos = 0;
            for (var i = 0; i < parts.length; i++) {
                if (!parts[i]) continue;
                var idx = cell.indexOf(parts[i], pos);
                if (idx === -1) return false;
                pos = idx + parts[i].length;
            }
            return true;
        }

        function renderSnapRows() {
            var cols    = snapState.columns;
            var filters = snapState.filters;
            var sc      = snapState.sortCol;
            var sd      = snapState.sortDir;

            var visible = snapState.rows.filter(function (r) {
                return cols.every(function (c) {
                    var f = filters[c] || '';
                    return matchFilter(r[c], f);
                });
            });

            if (sc !== null) {
                visible.sort(function (a, b) {
                    var av = a[sc], bv = b[sc];
                    if (av === null || av === undefined) av = '';
                    if (bv === null || bv === undefined) bv = '';
                    var n = !isNaN(parseFloat(av)) && !isNaN(parseFloat(bv));
                    var cmp = n ? parseFloat(av) - parseFloat(bv) : String(av).localeCompare(String(bv));
                    return cmp * sd;
                });
            }

            var tbody = visible.map(function (r) {
                return '<tr>' + cols.map(function (c) { return '<td>' + escHtml(r[c]) + '</td>'; }).join('') + '</tr>';
            }).join('') || '<tr><td colspan="' + cols.length + '" class="text-muted text-center">No rows match filters.</td></tr>';

            $('#snapTbody').html(tbody);
            $('#snapCount').text(visible.length.toLocaleString() + ' / ' + snapState.rows.length.toLocaleString() + ' rows');
        }

        var snapFilterTimer;

        // Bind panel event handlers once — avoids stacking duplicate handlers on
        // every table load which caused sort direction to flip multiple times per click.
        $panelDiv.on('click', '.snapSortTh', function () {
            var col = $(this).data('col');
            if (snapState.sortCol === col) {
                snapState.sortDir *= -1;
            } else {
                snapState.sortCol = col;
                snapState.sortDir = 1;
            }
            $panelDiv.find('.snapSortIcon').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort').css('opacity', '.4');
            $(this).find('.snapSortIcon').removeClass('fa-sort').addClass(snapState.sortDir === 1 ? 'fa-sort-up' : 'fa-sort-down').css('opacity', '1');
            renderSnapRows();
        });

        $panelDiv.on('input', '.snapFilter', function () {
            snapState.filters[$(this).data('col')] = $(this).val();
            clearTimeout(snapFilterTimer);
            snapFilterTimer = setTimeout(renderSnapRows, 180);
        });

        $panelDiv.on('click', '#snapClearFilters', function () {
            $panelDiv.find('.snapFilter').val('');
            snapState.filters = {};
            renderSnapRows();
        });

        var snapHiddenCols = { SnapshotYear: true, SnapshotQuarter: true };

        function buildSnapTable(tbl, data) {
            var cols = data.columns.filter(function (c) { return !snapHiddenCols[c]; });
            var rows = data.rows;
            snapState = { rows: rows, columns: cols, sortCol: null, sortDir: 1, filters: {} };

            var thCols = cols.map(function (c) {
                return '<th class="snapSortTh" data-col="' + escHtml(c) + '" style="cursor:pointer;white-space:nowrap;user-select:none;" title="Click to sort">'
                     + escHtml(c) + ' <i class="fal fa-sort snapSortIcon" style="opacity:.4;font-size:.7em;"></i></th>';
            }).join('');

            var filterCols = cols.map(function (c) {
                return '<th style="padding:2px 4px;"><input type="text" class="form-control form-control-sm snapFilter" '
                     + 'data-col="' + escHtml(c) + '" placeholder="filter…" style="font-size:.7rem;min-width:60px;" /></th>';
            }).join('');

            $panelDiv.html(
                '<div class="d-flex align-items-baseline mb-1">'
                + '<h6 class="font-weight-bold mb-0 mr-2">' + escHtml(tbl) + '</h6>'
                + '<small class="text-muted" id="snapCount"></small>'
                + '<button type="button" class="btn btn-link btn-sm ml-auto p-0 text-muted" id="snapClearFilters" title="Clear all filters" style="font-size:.75rem;">Clear filters</button>'
                + '</div>'
                + '<div style="overflow-x:auto;">'
                + '<table class="table table-sm table-bordered table-striped mb-0" id="snapTable" style="font-size:.75rem;white-space:nowrap;">'
                + '<thead class="thead-light">'
                + '<tr>' + thCols + '</tr>'
                + '<tr class="bg-white">' + filterCols + '</tr>'
                + '</thead>'
                + '<tbody id="snapTbody"></tbody>'
                + '</table></div>'
            );

            renderSnapRows();
        }

        function loadSnapshotTable(tbl) {
            $panelDiv.html('<p class="text-muted small"><i class="fa fa-spinner fa-spin mr-1"></i>Loading ' + tbl + '...</p>');
            $.getJSON(snapshotDataUrl, { releaseId: releaseIdSnap, tableName: tbl }, function (data) {
                if (!data.rows || data.rows.length === 0) {
                    $panelDiv.html('<p class="text-muted small">No rows in ' + tbl + ' for this quarter.</p>');
                    return;
                }
                buildSnapTable(tbl, data);
            }).fail(function () {
                $panelDiv.html('<p class="text-danger small">Failed to load table data.</p>');
            });
        }

        $('#releaseDetailSnapshotTab').on('shown.bs.tab', function () {
            if (snapshotLoaded) return;
            snapshotLoaded = true;
            $.getJSON(snapshotSummaryUrl, { id: releaseIdSnap }, function (result) {
                var tables = result.tables || [];
                var hasData = tables.some(function (t) { return t.rowCount > 0; });
                if (!hasData) {
                    $listDiv.html('<p class="text-muted small px-3">No snapshot for ' + result.year + ' ' + result.quarter + '.<br>Lock a Deploy record for this quarter first.</p>');
                    return;
                }

                var lastSide = '';
                var html = '<p class="text-muted small px-3 mb-1">' + result.year + ' ' + result.quarter + '</p>';
                tables.forEach(function (t) {
                    if (t.side !== lastSide) {
                        html += '<div class="px-3 pt-2 pb-1" style="font-size:.7rem;font-weight:600;text-transform:uppercase;color:#6c757d;letter-spacing:.05em;">' + t.side + '</div>';
                        lastSide = t.side;
                    }
                    var label = t.tableName.replace(/^tblPat|^tblTmk/, '');
                    html += '<a href="#" class="d-block px-3 py-1 snapshotTableLink" style="font-size:.8rem;color:inherit;text-decoration:none;" '
                          + 'data-table="' + t.tableName + '" title="' + t.tableName + ' (' + t.rowCount.toLocaleString() + ' rows)">'
                          + label + ' <span class="text-muted" style="font-size:.7rem;">(' + t.rowCount.toLocaleString() + ')</span></a>';
                });
                $listDiv.html(html);

                $listDiv.on('click', '.snapshotTableLink', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $listDiv.find('.snapshotTableLink').css({ background: '', fontWeight: '' });
                    $(this).css({ background: '#e9ecef', fontWeight: '600' });
                    loadSnapshotTable($(this).data('table'));
                });
            }).fail(function () {
                $listDiv.html('<p class="text-danger small px-3">Failed to load snapshot.</p>');
            });
        });
        // ────────────────────────────────────────────────────────────────

        $('.btnGenerateMdb').on('click', function() {
            var btn = $(this);
            var url = btn.data('url');
            var area = btn.data('area');
            cpiConfirm.confirm('Generate ' + area + ' MDB', 'Generate ' + area + ' MDB file for this release? This may take a moment.', function() {
                cpiLoadingSpinner.show();
                $.post(url).done(function(result) {
                    cpiLoadingSpinner.hide();
                    pageHelper.showSuccess(result.success || 'MDB files generated successfully.');
                    // Reload the detail page to show the new MDB in Documents
                    setTimeout(function() {
                        window.location.reload();
                    }, 1000);
                }).fail(function(e) {
                    cpiLoadingSpinner.hide();
                    pageHelper.showErrors(e);
                });
            });
        });
    });
</script>
