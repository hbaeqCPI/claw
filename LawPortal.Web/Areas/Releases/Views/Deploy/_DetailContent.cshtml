@model DeployPassword
@inject IStringLocalizer<SharedResource> Localizer
@{
    var id = Model.DeployPasswordId;
    var addMode = id == 0;

    var detailPagePermission = (DetailPagePermission)ViewData["PagePermission"];
    var fullModify = detailPagePermission.CanEditRecord && (!detailPagePermission.CanEditRemarksOnly);
    bool isReadOnly = !fullModify || Model.IsLocked;

    // Path → (tag, isPat, isMdb, field) mapping. Keeps the view declarative —
    // each row in the Pat / Tmk tab is just a lookup against this list.
    var patRows = new[]
    {
        new { Path = "LawDocs/Pat/Ver9and10/", Tag = "R4,PatR5-7",    IsMdb = false, Field = "PatVer9And10LawDocId", Value = Model.PatVer9And10LawDocId },
        new { Path = "Mdbs/Pat/Ver9and10/",    Tag = "R4",            IsMdb = true,  Field = "PatVer9And10MdbId",    Value = Model.PatVer9And10MdbId },
        new { Path = "Mdbs/Pat/R5/",           Tag = "PatR5-7",       IsMdb = true,  Field = "PatR5MdbId",           Value = Model.PatR5MdbId },
        new { Path = "LawDocs/Pat/R8/",        Tag = "PatR8-R10v2.1", IsMdb = false, Field = "PatR8LawDocId",        Value = Model.PatR8LawDocId },
        new { Path = "Mdbs/Pat/R8/",           Tag = "PatR8-R10v2.1", IsMdb = true,  Field = "PatR8MdbId",           Value = Model.PatR8MdbId }
    };
    var tmkRows = new[]
    {
        new { Path = "LawDocs/Tmk/Ver9and10/", Tag = "R4,TmkR5-8",    IsMdb = false, Field = "TmkVer9And10LawDocId", Value = Model.TmkVer9And10LawDocId },
        new { Path = "Mdbs/Tmk/Ver9and10/",    Tag = "R4",             IsMdb = true,  Field = "TmkVer9And10MdbId",    Value = Model.TmkVer9And10MdbId },
        new { Path = "Mdbs/Tmk/R5/",           Tag = "TmkR5-8",        IsMdb = true,  Field = "TmkR5MdbId",           Value = Model.TmkR5MdbId },
        new { Path = "LawDocs/Tmk/R9/",        Tag = "TmkR9-10v2.2",   IsMdb = false, Field = "TmkR9LawDocId",        Value = Model.TmkR9LawDocId },
        new { Path = "Mdbs/Tmk/R9/",           Tag = "TmkR9-10v2.2",   IsMdb = true,  Field = "TmkR9MdbId",           Value = Model.TmkR9MdbId }
    };

    var getDocsUrl = Url.Action("GetReleaseDocs", "Deploy", new { area = "Releases" });
}
<form id="detailForm" method="post" cpi-detail-form
      action="@Url.Action("Save", "Deploy", new { area = "Releases" })"
      data-error-message="@Localizer["An error occurred. No updates were made."]"
      data-save-message="@Localizer["Record has been saved successfully."]"
      data-cancel-title="@Localizer["Confirm Cancel Changes"]"
      data-cancel-message="@Localizer["Changes will not be saved. Do you want to continue?"]"
      data-delete-title="@Localizer["Confirm Delete"]"
      data-delete-message="@Localizer["You are about to delete this record. This operation cannot be undone."]"
      data-delete-success="@Localizer["Record has been deleted successfully."]">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DeployPasswordId" />
    @await Component.InvokeAsync("DetailPageNavLinks", new { pagePermission = detailPagePermission, title = "", addMode = addMode })

    <div class="page-content detail cpiMainEntry">
        <div class="form-row">
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 col-xl-2">
                <div class="form-group float-label">
                    <label asp-for="Year"></label>
                    @if (isReadOnly)
                    {
                        <input type="number" class="form-control form-control-sm" asp-for="Year" readonly />
                    }
                    else
                    {
                        @(Html.Kendo().NumericTextBox<int>()
                            .Name("Year")
                            .Value(Model.Year == 0 ? DateTime.Now.Year : Model.Year)
                            .Format("####")
                            .Decimals(0)
                            .Min(2000)
                            .Max(2100)
                            .HtmlAttributes(new { style = "width: 100%", placeholder = " " })
                        )
                    }
                    <span asp-validation-for="Year"></span>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 col-xl-2">
                <div class="form-group float-label">
                    <label asp-for="Quarter"></label>
                    @if (isReadOnly)
                    {
                        <input type="text" class="form-control form-control-sm" asp-for="Quarter" readonly />
                    }
                    else
                    {
                        @(Html.Kendo().DropDownList()
                            .Name("Quarter")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Q1", Value = "Q1" },
                                new SelectListItem { Text = "Q2", Value = "Q2" },
                                new SelectListItem { Text = "Q3", Value = "Q3" },
                                new SelectListItem { Text = "Q4", Value = "Q4" }
                            })
                            .Value(string.IsNullOrEmpty(Model.Quarter) ? "Q1" : Model.Quarter)
                            .HtmlAttributes(new { style = "width: 100%" })
                        )
                    }
                    <span asp-validation-for="Quarter"></span>
                </div>
            </div>
            <div class="col-auto d-flex align-items-center">
                @* "Populate Tables" — enabled only when all 12 dropdowns + both
                   passwords are filled. TRUNCATEs each target upd table before
                   inserting fresh rows, so a separate "Clear Tables" button is
                   no longer needed. *@
                <button type="button" class="btn btn-primary btn-sm btnDeploy" disabled
                        data-id="@Model.DeployPasswordId"
                        data-url="@Url.Action("Deploy", "Deploy", new { area = "Releases" })">
                    <i class="fal fa-upload pr-1"></i> @Localizer["Populate Tables"]
                </button>
            </div>
            <div class="col-auto d-flex align-items-center">
                @* "Generate Script" — sits next to Populate Tables; hidden
                   until at least one upd table has rows (so the user can't
                   generate from an empty staging set). Saves the .sql into
                   this deploy's Documents tab named
                   {Year}_{Quarter}_CountryLawScript.sql. *@
                <button type="button" class="btn btn-primary btn-sm btnGenerateScript" style="display:none;"
                        data-id="@Model.DeployPasswordId"
                        data-url="@Url.Action("GenerateScript", "Deploy", new { area = "Releases" })">
                    <i class="fal fa-file-code pr-1"></i> @Localizer["Generate Script"]
                </button>
            </div>
            @if (!addMode)
            {
                <div class="col-auto d-flex align-items-center ml-auto">
                    @if (Model.IsLocked)
                    {
                        <span class="badge badge-secondary px-3 py-2">
                            <i class="fal fa-lock pr-1"></i>
                            @Localizer["Locked"] @(Model.LockedAt?.ToString("yyyy-MM-dd") ?? "")
                            @(Model.LockedBy != null ? $"by {Model.LockedBy}" : "")
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-warning btn-sm btnLockQuarter"
                                data-id="@Model.DeployPasswordId"
                                data-url="@Url.Action("LockQuarter", "Deploy", new { area = "Releases" })">
                            <i class="fal fa-lock pr-1"></i> @Localizer["Lock Quarter"]
                        </button>
                    }
                </div>
            }
        </div>

        <ul class="nav nav-tabs detail cpiDetailInfoNav nav-tabs-horizontal mt-3" role="tablist">
            <li class="nav-item">
                <a id="deployDetailPatentTab" href="#deployDetailPatentTabContent"
                   class="nav-link active" data-toggle="tab" role="tab"
                   aria-controls="deployDetailPatentTabContent" aria-selected="true"
                   title="@Localizer["Patent"]">@Localizer["Patent"]</a>
            </li>
            <li class="nav-item">
                <a id="deployDetailTrademarkTab" href="#deployDetailTrademarkTabContent"
                   class="nav-link" data-toggle="tab" role="tab"
                   aria-controls="deployDetailTrademarkTabContent" aria-selected="false"
                   title="@Localizer["Trademark"]">@Localizer["Trademark"]</a>
            </li>
            <li class="nav-item">
                <a id="deployDetailDocumentsTab" href="#deployDetailDocumentsTabContent"
                   class="nav-link" data-toggle="tab" role="tab"
                   aria-controls="deployDetailDocumentsTabContent" aria-selected="false"
                   title="@Localizer["Documents"]">@Localizer["Documents"]</a>
            </li>
        </ul>
        <div class="tab-content detail">
            <div class="tab-pane active show p-3" id="deployDetailPatentTabContent"
                 role="tabpanel" aria-labelledby="deployDetailPatentTab">
                <div class="form-row align-items-end">
                    <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4">
                        <div class="form-group float-label mb-0">
                            <label asp-for="PatentPassword"></label>
                            <input type="text" class="form-control form-control-sm"
                                   asp-for="PatentPassword" asp-is-readonly="@isReadOnly"
                                   asp-is-autofocus="@addMode" maxlength="30" autocomplete="off" />
                            <span asp-validation-for="PatentPassword"></span>
                        </div>
                    </div>
                    <div class="col-auto mb-1">
                        <button type="button" class="btn btn-secondary btn-sm btnPushPat" disabled
                                data-id="@Model.DeployPasswordId"
                                data-url="@Url.Action("PushMdbs", "Deploy", new { area = "Releases" })"
                                data-side="pat">
                            <i class="fal fa-share-square pr-1"></i> @Localizer["Push"]
                        </button>
                    </div>
                </div>

                @* Per-path doc selections. Each row is one hardcoded deploy path
                   with a dropdown of matching Release documents. The dropdown is
                   populated on tab activation via the deployPathDropdowns script
                   at the bottom of this view, so the year/quarter at the top is
                   the source of truth for the filter. *@
                <hr class="my-3" />
                <div class="d-flex" style="gap:2rem;">
                    <div style="flex:1;">
                        <h6 class="font-weight-bold mb-2 text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">LawDocs</h6>
                        @foreach (var row in patRows.Where(r => !r.IsMdb))
                        {
                            <div class="form-row align-items-center mb-2">
                                <div class="col-12">
                                    <code class="text-dark d-block mb-1" style="font-size:.75rem;">@row.Path</code>
                                    <select name="@row.Field" id="@row.Field"
                                            class="form-control form-control-sm deploy-doc-dropdown"
                                            data-tag="@row.Tag" data-is-pat="true" data-is-mdb="false"
                                            data-current-value="@(row.Value?.ToString() ?? "")">
                                        <option value="">@Localizer["-- Select --"]</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                    <div style="flex:1;border-left:1px solid #dee2e6;padding-left:2rem;">
                        <h6 class="font-weight-bold mb-2 text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">MDBs</h6>
                        @foreach (var row in patRows.Where(r => r.IsMdb))
                        {
                            <div class="form-row align-items-center mb-2">
                                <div class="col-12">
                                    <code class="text-dark d-block mb-1" style="font-size:.75rem;">@row.Path</code>
                                    <select name="@row.Field" id="@row.Field"
                                            class="form-control form-control-sm deploy-doc-dropdown"
                                            data-tag="@row.Tag" data-is-pat="true" data-is-mdb="true"
                                            data-current-value="@(row.Value?.ToString() ?? "")">
                                        <option value="">@Localizer["-- Select --"]</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="tab-pane p-3" id="deployDetailTrademarkTabContent"
                 role="tabpanel" aria-labelledby="deployDetailTrademarkTab">
                <div class="form-row align-items-end">
                    <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4">
                        <div class="form-group float-label mb-0">
                            <label asp-for="TrademarkPassword"></label>
                            <input type="text" class="form-control form-control-sm"
                                   asp-for="TrademarkPassword" asp-is-readonly="@isReadOnly"
                                   maxlength="30" autocomplete="off" />
                            <span asp-validation-for="TrademarkPassword"></span>
                        </div>
                    </div>
                    <div class="col-auto mb-1">
                        <button type="button" class="btn btn-secondary btn-sm btnPushTmk" disabled
                                data-id="@Model.DeployPasswordId"
                                data-url="@Url.Action("PushMdbs", "Deploy", new { area = "Releases" })"
                                data-side="tmk">
                            <i class="fal fa-share-square pr-1"></i> @Localizer["Push"]
                        </button>
                    </div>
                </div>

                <hr class="my-3" />
                <div class="d-flex" style="gap:2rem;">
                    <div style="flex:1;">
                        <h6 class="font-weight-bold mb-2 text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">LawDocs</h6>
                        @foreach (var row in tmkRows.Where(r => !r.IsMdb))
                        {
                            <div class="form-row align-items-center mb-2">
                                <div class="col-12">
                                    <code class="text-dark d-block mb-1" style="font-size:.75rem;">@row.Path</code>
                                    <select name="@row.Field" id="@row.Field"
                                            class="form-control form-control-sm deploy-doc-dropdown"
                                            data-tag="@row.Tag" data-is-pat="false" data-is-mdb="false"
                                            data-current-value="@(row.Value?.ToString() ?? "")">
                                        <option value="">@Localizer["-- Select --"]</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                    <div style="flex:1;border-left:1px solid #dee2e6;padding-left:2rem;">
                        <h6 class="font-weight-bold mb-2 text-muted" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">MDBs</h6>
                        @foreach (var row in tmkRows.Where(r => r.IsMdb))
                        {
                            <div class="form-row align-items-center mb-2">
                                <div class="col-12">
                                    <code class="text-dark d-block mb-1" style="font-size:.75rem;">@row.Path</code>
                                    <select name="@row.Field" id="@row.Field"
                                            class="form-control form-control-sm deploy-doc-dropdown"
                                            data-tag="@row.Tag" data-is-pat="false" data-is-mdb="true"
                                            data-current-value="@(row.Value?.ToString() ?? "")">
                                        <option value="">@Localizer["-- Select --"]</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Documents tab — folder tree + grid, same UX as Release
               Documents. The partial is only rendered for saved records
               (id > 0) because the folder hierarchy is keyed off
               DeployPasswordId; for a fresh Add it has nothing to anchor to. *@
            <div class="tab-pane p-3" id="deployDetailDocumentsTabContent"
                 role="tabpanel" aria-labelledby="deployDetailDocumentsTab">
                @if (Model.DeployPasswordId > 0)
                {
                    @await Html.PartialAsync("_DocumentTree", Model)
                }
                else
                {
                    <div class="text-muted">
                        <i class="fal fa-folder-tree pr-1"></i>
                        @Localizer["Save the record first to manage documents."]
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!addMode)
    {
        <div class="content-stamp">
            @await Component.InvokeAsync("RecordStamps", new { createdBy = Model.CreatedBy, dateCreated = Model.DateCreated, updatedBy = Model.UpdatedBy, lastUpdate = Model.LastUpdate, tStamp = new byte[0] })
        </div>
    }
</form>

<script>
    $(document).ready(function () {
        // Populates each .deploy-doc-dropdown by calling GetReleaseDocs with the
        // year/quarter from the top of the form + the tag/side/file-type data
        // attributes on each <select>. Re-fires whenever Year or Quarter changes
        // so users see fresh options without saving.
        var getDocsUrl = '@Html.Raw(getDocsUrl)';

        function currentYearQuarter() {
            var year = parseInt($('#Year').val(), 10) || new Date().getFullYear();
            // Kendo DropDownList stores value on a hidden input with the same name.
            var quarter = $('#Quarter').val() || 'Q1';
            return { year: year, quarter: quarter };
        }

        function populateDropdown($sel) {
            var yq = currentYearQuarter();
            var data = {
                year: yq.year,
                quarter: yq.quarter,
                systemTag: $sel.data('tag'),
                isPat: $sel.data('is-pat') === true || $sel.data('is-pat') === 'true',
                isMdb: $sel.data('is-mdb') === true || $sel.data('is-mdb') === 'true'
            };
            var currentValue = $sel.data('current-value');
            $.getJSON(getDocsUrl, data, function (docs) {
                // Reset to placeholder + freshly-fetched options. Iterate the
                // response defensively: support both camelCase (System.Text.Json)
                // and PascalCase (Newtonsoft) shapes since the API serializer
                // config isn't guaranteed across deploys.
                $sel.find('option:not(:first)').remove();
                (docs || []).forEach(function (d) {
                    var id = d.docId !== undefined ? d.docId : d.DocId;
                    var text = d.text !== undefined ? d.text : d.Text;
                    $sel.append($('<option>').val(id).text(text));
                });
                if (currentValue) {
                    $sel.val(String(currentValue));
                }
                // Programmatic .val() doesn't fire change, so re-evaluate the
                // Deploy button manually once the saved selection lands.
                if (typeof refreshDeployButton === 'function') refreshDeployButton();
                if (typeof refreshPushButtons === 'function') refreshPushButtons();
            }).fail(function (e) {
                pageHelper.showErrors(e);
            });
        }

        function refreshAllDropdowns() {
            $('.deploy-doc-dropdown').each(function () {
                populateDropdown($(this));
            });
        }

        refreshAllDropdowns();
        // Re-fetch when Year or Quarter changes — both Kendo and plain inputs
        // bubble a "change" event on their underlying form field.
        $('#Year, #Quarter').on('change', refreshAllDropdowns);

        // ────────────────────────────────────────────────────────────────
        // Deploy button: enables only when every dropdown has a selection
        // and both password fields are non-empty. Click invokes the Deploy
        // POST which populates upd* tables from the saved MDB selections.
        // Note: deploy reads from the SAVED record, so the user must Save
        // any new dropdown picks before deploy reflects them.
        // ────────────────────────────────────────────────────────────────
        function isDeployReady() {
            var allDropdowns = $('.deploy-doc-dropdown').toArray();
            var allFilled = allDropdowns.length > 0 && allDropdowns.every(function (s) {
                return $(s).val() !== '' && $(s).val() != null;
            });
            var patPwd = $('#PatentPassword').val() || '';
            var tmkPwd = $('#TrademarkPassword').val() || '';
            return allFilled && patPwd.length > 0 && tmkPwd.length > 0;
        }

        function refreshDeployButton() {
            $('.btnDeploy').prop('disabled', !isDeployReady());
        }

        // Hook every input that influences ready-state. Selects bubble
        // "change"; password fields bubble "input".
        $('.deploy-doc-dropdown').on('change', refreshDeployButton);
        $('#PatentPassword, #TrademarkPassword').on('input change', refreshDeployButton);
        refreshDeployButton();

        // ────────────────────────────────────────────────────────────────
        // Push buttons: enabled when all selects in the respective tab
        // are filled. Copies the 3 MDB files for that side to the UNC
        // share (\\edm2016\test\Mdbs\Pat or \Tmk) via a server action.
        // ────────────────────────────────────────────────────────────────
        function isPatSelectsFilled() {
            var patSelects = $('[data-is-pat="true"].deploy-doc-dropdown').toArray();
            return patSelects.length > 0 && patSelects.every(function (s) {
                return $(s).val() !== '' && $(s).val() != null;
            });
        }
        function isTmkSelectsFilled() {
            var tmkSelects = $('[data-is-pat="false"].deploy-doc-dropdown').toArray();
            return tmkSelects.length > 0 && tmkSelects.every(function (s) {
                return $(s).val() !== '' && $(s).val() != null;
            });
        }
        function refreshPushButtons() {
            $('.btnPushPat').prop('disabled', !isPatSelectsFilled());
            $('.btnPushTmk').prop('disabled', !isTmkSelectsFilled());
        }
        $('.deploy-doc-dropdown').on('change', refreshPushButtons);
        refreshPushButtons();

        function handlePushClick($btn) {
            $btn.off('click').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var url = $btn.data('url');
                var id = $btn.data('id');
                var side = $btn.data('side');
                if (!id || id <= 0) {
                    pageHelper.showErrors('@Localizer["Save the record before pushing."]');
                    return;
                }
                cpiConfirm.confirm(
                    '@Localizer["Push MDBs?"]',
                    '@Localizer["This will copy the selected MDB files to the edm2016 network share. Continue?"]',
                    function () {
                        cpiLoadingSpinner.show();
                        $btn.prop('disabled', true);
                        $.ajax({
                            type: 'POST',
                            url: url + '?id=' + encodeURIComponent(id) + '&side=' + encodeURIComponent(side),
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            }
                        }).done(function (result) {
                            cpiLoadingSpinner.hide();
                            pageHelper.showSuccess(result.success || '@Localizer["Push completed."]');
                            }).fail(function (ex) {
                            cpiLoadingSpinner.hide();
                            pageHelper.showErrors(ex);
                            }).always(function () {
                            refreshPushButtons();
                        });
                    });
            });
        }
        handlePushClick($('.btnPushPat'));
        handlePushClick($('.btnPushTmk'));

        $('.btnDeploy').off('click').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            var url = $btn.data('url');
            var id = $btn.data('id');
            if (!id || id <= 0) {
                pageHelper.showErrors('@Localizer["Save the record before deploying."]');
                return;
            }
            cpiConfirm.confirm(
                '@Localizer["Deploy?"]',
                '@Localizer["This will populate the upd tables from the selected MDBs. Existing rows in those tables will be replaced. Continue?"]',
                function () {
                    cpiLoadingSpinner.show();
                    $btn.prop('disabled', true);
                    $.ajax({
                        type: 'POST',
                        url: url + '?id=' + encodeURIComponent(id),
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    }).done(function (result) {
                        cpiLoadingSpinner.hide();
                        pageHelper.showSuccess(result.success || '@Localizer["Deploy completed."]');
                        // After a successful deploy, the upd tables have rows.
                        // Re-check so the On-Prem tab's button reveals itself.
                        refreshOnPremReady();
                    }).fail(function (e) {
                        cpiLoadingSpinner.hide();
                        pageHelper.showErrors(e);
                    }).always(function () {
                        refreshDeployButton();
                    });
                });
        });

        // ────────────────────────────────────────────────────────────────
        // Generate Script button (lives next to Populate Tables now).
        // Hidden until the server confirms at least one upd table has
        // rows — i.e. Populate Tables has actually run.
        // ────────────────────────────────────────────────────────────────
        var generateScriptUrl = '@Html.Raw(Url.Action("GenerateScript", "Deploy", new { area = "Releases" }))';
        var hasDeployedDataUrl = '@Html.Raw(Url.Action("HasDeployedData", "Deploy", new { area = "Releases" }))';
        var deployPasswordId = @Model.DeployPasswordId;

        function refreshOnPremReady() {
            if (!deployPasswordId || deployPasswordId <= 0) {
                $('.btnGenerateScript').hide();
                return;
            }
            $.getJSON(hasDeployedDataUrl, { id: deployPasswordId })
                .done(function (result) {
                    var ready = !!(result && (result.ready === true || result.Ready === true));
                    $('.btnGenerateScript').toggle(ready);
                })
                .fail(function () {
                    $('.btnGenerateScript').hide();
                });
        }

        refreshOnPremReady();

        // ────────────────────────────────────────────────────────────────
        // Lock Quarter button — copies all tbl* tables to hist_* and sets
        // IsLocked permanently. Reloads the page on success so the locked
        // badge renders and all inputs become read-only.
        // ────────────────────────────────────────────────────────────────
        $('.btnLockQuarter').off('click').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            var url = $btn.data('url');
            var id = $btn.data('id');
            if (!id || id <= 0) return;
            cpiConfirm.confirm(
                '@Localizer["Lock Quarter?"]',
                '@Localizer["This will permanently snapshot all Pat/Tmk tables for this quarter. The record will become read-only. This cannot be undone."]',
                function () {
                    cpiLoadingSpinner.show();
                    $btn.prop('disabled', true);
                    $.ajax({
                        type: 'POST',
                        url: url + '?id=' + encodeURIComponent(id),
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() }
                    }).done(function (result) {
                        cpiLoadingSpinner.hide();
                        pageHelper.showSuccess(result.success || '@Localizer["Quarter locked."]');
                        setTimeout(function () { window.location.reload(); }, 1200);
                    }).fail(function (ex) {
                        cpiLoadingSpinner.hide();
                        $btn.prop('disabled', false);
                        pageHelper.showErrors(ex);
                    });
                });
        });

        $('.btnGenerateScript').off('click').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this);
            var id = $btn.data('id');
            if (!id || id <= 0) return;
            cpiLoadingSpinner.show();
            $btn.prop('disabled', true);
            $.ajax({
                type: 'POST',
                url: generateScriptUrl + '?id=' + encodeURIComponent(id),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            }).done(function (result) {
                cpiLoadingSpinner.hide();
                pageHelper.showSuccess(result.success || '@Localizer["Script generated."]');
                refreshDeployLog();
                // Refresh the Documents tree so the new .sql file appears
                // immediately. The tree IIFE is global on the page and the
                // selected folder's grid will re-read after the tree reloads.
                var tv = (typeof deployDocTree_@Model.DeployPasswordId !== 'undefined')
                    ? $('#deployDocumentTree_@Model.DeployPasswordId').data('kendoTreeView')
                    : null;
                if (tv) {
                    var sel = tv.select();
                    if (sel && sel.length) {
                        var item = tv.dataItem(sel);
                        if (item && typeof item.loaded === 'function') {
                            item.loaded(false);
                            item.load();
                        }
                    }
                    tv.dataSource.read();
                }
                var grid = $('#deployImageGridView_@Model.DeployPasswordId').data('kendoGrid');
                if (grid) grid.dataSource.read();
            }).fail(function (e) {
                cpiLoadingSpinner.hide();
                pageHelper.showErrors(e);
                refreshDeployLog();
            }).always(function () {
                $btn.prop('disabled', false);
            });
        });
    });
</script>
