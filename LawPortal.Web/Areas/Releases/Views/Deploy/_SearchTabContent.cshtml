@model PageViewModel
@inject IStringLocalizer<SharedResource> Localizer

<div class="tab-content search page-content">
    <div class="tab-pane show active" id="deploySearchMainTabContent" aria-labelledby="deploySearchMainTab" role="tabpanel">
        <div class="form-row">
            <div class="col-md-3">
                <div class="form-group float-label">
                    <label for="Year">@Localizer["Year"]</label>
                    @await Component.InvokeAsync("ComboBox", new { name = "Year", multiSelect = true })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group float-label">
                    <label for="Quarter">@Localizer["Quarter"]</label>
                    @await Component.InvokeAsync("ComboBox", new { name = "Quarter", multiSelect = true })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group float-label">
                    <label for="PatentPassword">@Localizer["Patent Password"]</label>
                    @await Component.InvokeAsync("ComboBox", new { name = "PatentPassword", multiSelect = true })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group float-label">
                    <label for="TrademarkPassword">@Localizer["Trademark Password"]</label>
                    @await Component.InvokeAsync("ComboBox", new { name = "TrademarkPassword", multiSelect = true })
                </div>
            </div>
        </div>
        <div class="form-row mt-4">
            <div class="col-md-4">
                <div class="form-group float-label">
                    <label for="CreatedBy">@Localizer["Created By"]</label>
                    @await Component.InvokeAsync("ComboBox", new { name = "CreatedBy", multiSelect = true })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group float-label">
                    <label for="DateCreatedFrom">@Localizer["Date Created From"]</label>
                    @await Component.InvokeAsync("DatePicker", new DatePickerOptions("DateCreatedFrom"))
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group float-label">
                    <label for="DateCreatedTo">@Localizer["Date Created To"]</label>
                    @await Component.InvokeAsync("DatePicker", new DatePickerOptions("DateCreatedTo"))
                </div>
            </div>
        </div>
    </div>
</div>
