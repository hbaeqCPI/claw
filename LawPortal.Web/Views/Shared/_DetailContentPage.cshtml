@model PageViewModel
@using Newtonsoft.Json
@{
    bool addMode = Model.RecordId == 0;
    bool addFromOtherScreen = false;
    if (addMode)
    {
        string referer = ViewContext.HttpContext.Request.Headers["Referer"].ToString().ToLower();
        string controller = ViewContext.ActionDescriptor.RouteValues["controller"]?.ToString().ToLower();
        addFromOtherScreen = (!ViewContext.HttpContext.Request.IsAjax() || !referer.Contains(controller));
    }

    // How to name the record on screen when reloading it (see onCancel below).
    // Screens keyed on a composite report a RecordKey and only a sentinel RecordId,
    // so they have to navigate by key — same choice the record navigator makes.
    // Emitted with Html.Raw: the key is a query fragment whose & must stay literal,
    // and RecordNavigationKey has already percent-encoded the values inside it.
    var cancelRecordArg = string.IsNullOrEmpty(Model.RecordKey)
        ? Model.RecordId.ToString()
        : $"\"{Model.RecordKey}\"";

    // The url that re-requests the record on screen. A screen keyed on a composite has
    // no usable id — RecordId is only a sentinel (1) — so Url.Action("Detail", new { id
    // = 1 }) yields .../Detail/1, which names no record at all: Detail binds empty
    // country/caseType and redirects to Index. That is the breadcrumb "back" landing on
    // the search screen instead of the record. Name the record with its RecordKey query
    // fragment instead, which is what its Detail action binds from.
    var detailUrlValue = string.IsNullOrEmpty(Model.RecordKey)
        ? Url.Action("Detail", new { id = addMode ? "recid" : Model.RecordId.ToString(), singleRecord = Model.FromSearch || Model.SingleRecord })
        : $"{Url.Action("Detail", new { id = (string?)null })}?{Model.RecordKey}";
}

@await Html.PartialAsync(string.IsNullOrEmpty(Model.PartialViewName) ? "_DetailContent" : Model.PartialViewName, Model.Data, new ViewDataDictionary(this.ViewData) { { "PagePermission", Model.PagePermission }, { "PageId", Model.PageId } })

<script>
    $(document).ready(function () {
        // Show any pending post-save toast handed off by the previous page
        // (full redirect after save would otherwise discard it).
        try {
            var pending = sessionStorage.getItem('cpiPostSaveMessage');
            if (pending && typeof cpiStatusMessage !== 'undefined') {
                cpiStatusMessage.success(pending, 3000);
                sessionStorage.removeItem('cpiPostSaveMessage');
            }
        } catch (e) { /* ignore */ }

        var pageReady = function () {
            @*if (typeof @ViewBag.ActivePage === 'undefined') {
                setTimeout(pageReady, 50);
                return;
            }*@

            @(ViewBag.ActivePage).initializeDetailContentPage({
                requestedUrl: "@Context.Request.PathBase@Context.Request.Path",
                @* The address-bar url, WITH the query string: a composite-keyed screen names
                   its record there (Detail?country=..&caseType=..), so the path alone reloads
                   to the search screen on refresh or Back. Kept apart from requestedUrl, which
                   the breadcrumbs match on by path. JavaScriptEncoder keeps its & literal. *@
                historyUrl: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode($"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}"))",
                detailUrl: "@Html.Raw(detailUrlValue)",   @* Raw: a RecordKey's & must stay literal; its values are already percent-encoded *@
                recordKey: "@Html.Raw(Model.RecordKey)",
                searchUrl: "@Url.Action("Index")",
                title: "@Html.Raw(Model.Title)",
                recordStampsUrl: "@Url.Action("GetRecordStamps", new { id = Model.RecordId })",
                recordStampsContainer: "DetailRecordStamps",
                deleteForm: "",
                id: @Model.RecordId,
                addMode: @(Model.RecordId == 0 ? "true" : "false"),
                addFromSearch: @(Model.FromSearch ? "true" : "false"),  //todo: persist through steps
                addFromOtherScreen: @(addFromOtherScreen ? "true" : "false"),
                activeTab: "@Model.ActiveTab",
                addModeOptions: {
                    @Html.Raw(string.IsNullOrEmpty(Model.BeforeSubmit) ? "" : $"beforeSubmit: {Model.BeforeSubmit}, ")
                    @Html.Raw(string.IsNullOrEmpty(Model.AfterInsert) ? "" : $"afterSubmit: {Model.AfterInsert}, ")
                    @Html.Raw(Model.AfterInsertOptions == null ? "" : $"afterSubmitOptions: {JsonConvert.SerializeObject(Model.AfterInsertOptions)}, ")
                    @Html.Raw(string.IsNullOrEmpty(Model.AfterCancelledInsert) ? "" : $"onCancel: {Model.AfterCancelledInsert}, ")
                },
                editModeOptions: {
                    @Html.Raw(Model.RecordId == 0 || string.IsNullOrEmpty(Model.BeforeSubmit) ? "" : $"beforeSubmit: {Model.BeforeSubmit}, ")
                    afterSubmit: function(result) {
                        if (result && result.redirectUrl) {
                            cpiBreadCrumbs.markLastNode({ dirty: false });
                            $(window).off('beforeunload');
                            // The save success toast was just queued on this page;
                            // a full navigation tears it down before it renders.
                            // Hand the message to the next page via sessionStorage
                            // so it can be shown after the redirect completes.
                            try {
                                var msg = $('form[data-save-message]').data('save-message');
                                if (msg) sessionStorage.setItem('cpiPostSaveMessage', msg);
                            } catch (e) { /* sessionStorage unavailable — ignore */ }
                            window.location.href = result.redirectUrl;
                        } else {
                            var id = result && result.id ? result.id : (result || 0);
                            @(ViewBag.ActivePage).showDetails(id);
                        }
                    },
                    // Cancelling an edit discards the pending changes and reloads the
                    // record being edited — it must NOT leave the record for the search
                    // screen. Re-request it the same way afterSubmit and the record
                    // navigator do (see cancelRecordArg above).
                    onCancel: function() {
                        cpiBreadCrumbs.markLastNode({ dirty: false });
                        @(ViewBag.ActivePage).showDetails(@Html.Raw(cancelRecordArg));
                    }
                }
            });
        };

        pageReady();
    });
</script>